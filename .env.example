# Bugout environment variables. Copy to .env.local and fill in what you need.
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so never
# put a secret here, and rebuild after changing a value.

# --- Commerce provider (src/infrastructure/config/appConfig.ts) ---------------
# "local" (default): bundled JSON catalog, localStorage cart and the in-app demo
# checkout (no payment, no real order). "shopify": Storefront API + hosted checkout.
NEXT_PUBLIC_COMMERCE_PROVIDER=local

# Required when NEXT_PUBLIC_COMMERCE_PROVIDER=shopify; the app fails at startup without them.
# Also added to the production CSP connect-src (next.config.ts).
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Public Storefront API access token (designed to be exposed to browsers; not an Admin API token).
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Storefront API version. Defaults to 2026-07; keep it inside Shopify's supported window.
# NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07

# --- Analytics (src/infrastructure/config/appConfig.ts) -----------------------
# PostHog project API key. Leave empty to disable analytics (no-op adapter).
# PostHog loads only after the visitor accepts analytics cookies.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. Default "/ingest": the first-party EU proxy defined in next.config.ts.
# An absolute host here is also added to the production CSP connect-src.
# NEXT_PUBLIC_POSTHOG_HOST=/ingest

# --- Site (src/presentation/config/site.ts) -----------------------------------
# Canonical origin for metadata, sitemap.xml, robots.txt and structured data.
# Fallbacks: https://$VERCEL_PROJECT_PRODUCTION_URL (set automatically by Vercel; not
# NEXT_PUBLIC, read on the server only), then http://localhost:3000. A production build
# warns when it falls back to localhost. Leave it commented locally; set it to the
# production origin (e.g. https://bugout.es) before deploying.
# NEXT_PUBLIC_SITE_URL=https://bugout.es
# Support email shown on the contact and legal pages; hidden when empty. Required
# before launch: the LSSI requires a contact email in the seller identity, and the
# contact form backend is still simulated.
NEXT_PUBLIC_CONTACT_EMAIL=

# Seller identity required by the LSSI (art. 10), shown on the legal pages.
# Each field is hidden when empty. Set all three before launch.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=

# --- End-to-end tests (playwright.config.ts) ----------------------------------
# Port for the `next start` server Playwright launches (default 3100).
# E2E_PORT=3100
# Set to 1 to test a server that is already running on E2E_PORT instead of starting one.
# E2E_SKIP_SERVER=1
